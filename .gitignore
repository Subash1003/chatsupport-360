# ---------------------------------------------------------------------------
# Repo-wide ignore. The backend/ and frontend/ folders also have their own
# .gitignore; this is the catch-all so nothing sensitive slips through.
# ---------------------------------------------------------------------------

# Secrets / environment — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.vite/
.cache/

# Logs & runtime junk
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed

# Test / tooling scratch files
coverage/
.nyc_output/
tests/.e2e-*
*.local

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
