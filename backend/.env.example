# ---------------------------------------------------------
# PHASE 1 - only these are actually used right now
# ---------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------
# PHASE 2 - MySQL
# MYSQL_PASSWORD may be left empty if your local root account
# has no password (common with XAMPP/WAMP).
# ---------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=cs_chatbot

# ---------------------------------------------------------
# PHASE 3 - Auth
# ---------------------------------------------------------
# Required. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# ms-style ('7d', '12h', '30m') or a number of seconds. Defaults to 7d.
JWT_EXPIRES_IN=7d

# OTP behaviour (all optional; defaults shown)
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_SIGNUP_GRACE_MINUTES=30

# Email transport for OTP delivery.
#   console = print the OTP to the backend terminal (default, no account needed)
# Add real transports in src/services/email.service.js and switch this value.
EMAIL_TRANSPORT=console
EMAIL_FROM=no-reply@cs-ai-chatbot.local
# Only needed once a real email provider transport is added.
EMAIL_API_KEY=

# --- SMTP (EMAIL_TRANSPORT=smtp) -------------------------------------------
# Real email over SMTP. Gmail example (needs 2-Step Verification ON, then create
# an "App password" at https://myaccount.google.com/apppasswords):
#   EMAIL_TRANSPORT=smtp
#   EMAIL_FROM=youraddress@gmail.com
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your16charapppassword
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Resend (EMAIL_TRANSPORT=resend) --------------------------------------
# https://resend.com  -> API Keys.  EMAIL_FROM must be a verified sender.
RESEND_API_KEY=

# ---------------------------------------------------------
# PHASE 5 - Qdrant vector store + embeddings
# ---------------------------------------------------------
# Qdrant Cloud free tier: https://cloud.qdrant.io  (or a local instance).
# Blank is allowed; the /api/ingest endpoints then return 503 until it is set.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=cs_chatbot_kb

# Embeddings. Pluggable; default provider is Gemini gemini-embedding-001,
# pinned to 768 dims via outputDimensionality. Free tier. Key:
# https://aistudio.google.com/apikey
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=

# ---------------------------------------------------------
# PHASE 6 - LLM (chat answer generation)
# ---------------------------------------------------------
# OpenAI-compatible chat completions. Defaults target Groq (https://console.groq.com).
# For OpenAI/Together/etc. change LLM_BASE_URL + LLM_MODEL and set LLM_PROVIDER=openai.
# DeepSeek example:
#   LLM_PROVIDER=deepseek
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
#   LLM_API_KEY=sk-...
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=1024

# ---------------------------------------------------------
# PHASE 7 - RAG retrieval
# ---------------------------------------------------------
# RAG_TOP_K   = vector hits to pull per query
# RAG_MIN_SCORE = drop hits below this cosine score (0..1)
RAG_TOP_K=6
RAG_MIN_SCORE=0.55

# ---------------------------------------------------------
# PHASE 8 - query classification
# ---------------------------------------------------------
# When the keyword rules do not match, ask the LLM once to classify (true/false)
CLASSIFIER_LLM_FALLBACK=true

# ---------------------------------------------------------
# PHASE 9 - security hardening (rate limiting)
# ---------------------------------------------------------
# RATE_LIMIT_WINDOW_MS  shared sliding window for all buckets (ms)
# RATE_LIMIT_MAX         requests/window/IP across /api (health is exempt)
# AUTH_RATE_LIMIT_MAX    requests/window/IP on /api/auth   (brute-force guard)
# CHAT_RATE_LIMIT_MAX    requests/window/IP on /api/chat   (LLM cost guard)
# LEADS_RATE_LIMIT_MAX   requests/window/IP on /api/leads  (public write / spam)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_MAX=40
LEADS_RATE_LIMIT_MAX=5

# ---------------------------------------------------------
# PHASE 10 - conversation memory
# ---------------------------------------------------------
# HISTORY_MAX_MESSAGES  prior user/bot messages replayed to the LLM (~5 turns)
# HISTORY_MAX_CHARS      per-message truncation before it goes in the prompt
HISTORY_MAX_MESSAGES=10
HISTORY_MAX_CHARS=1500

# ---------------------------------------------------------
# Logging (pino structured logs + per-request tracing)
# ---------------------------------------------------------
# LOG_LEVEL: trace|debug|info|warn|error|fatal. Leave blank for the default
# (debug in development, info in production). Health-check requests log at debug.
# Secrets/PII (Authorization, cookies, passwords, OTPs, tokens, api keys) are
# always redacted regardless of level. Dev output is pretty-printed; production
# emits one JSON object per line to stdout.
LOG_LEVEL=info

# Suggested follow-up question chips under each answer (true/false).
CHAT_FOLLOWUPS=true
